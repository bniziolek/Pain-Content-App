# =============================================================================
# Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# See docs/data/ENVIRONMENT_REFERENCE.md for complete documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Core Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection URL (REQUIRED)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Session encryption secret (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here-min-32-chars

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port the application listens on (default: 5000)
PORT=5000

# Node environment: development, production, test
NODE_ENV=development

# Application URL (used for Stripe return URLs, email links, etc.)
APP_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Stripe Payments (required if using subscription features)
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Contentful CMS (optional - falls back to database if not set)
# -----------------------------------------------------------------------------

# CONTENTFUL_SPACE_ID=your-space-id
# CONTENTFUL_ACCESS_TOKEN=your-access-token

# -----------------------------------------------------------------------------
# Feature Flags / Runtime Toggles
# -----------------------------------------------------------------------------

# Enable/disable background jobs (default: true in production)
# BACKGROUND_JOBS_ENABLED=true

# Enable/disable Stripe sync (default: true if Stripe configured)
# STRIPE_SYNC_ENABLED=true

# Disable health metrics recording
# DISABLE_HEALTH_METRICS=false

# -----------------------------------------------------------------------------
# Email Services (configured via Replit integrations)
# -----------------------------------------------------------------------------
# Email is handled via Resend/Gmail integrations - no manual config needed

# -----------------------------------------------------------------------------
# Replit Runtime (auto-provided when running on Replit, do not set manually)
# These are provided automatically by the Replit platform.
# For non-Replit deployments, these are not needed.
# -----------------------------------------------------------------------------
# REPLIT_DEV_DOMAIN - Auto-set by Replit
# REPLIT_DOMAINS - Auto-set by Replit
# REPLIT_DEPLOYMENT - Auto-set by Replit
# REPLIT_CONNECTORS_HOSTNAME - Auto-set for integrations
# REPL_IDENTITY - Auto-set for integrations
